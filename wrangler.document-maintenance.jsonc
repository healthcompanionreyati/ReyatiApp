{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qivaya-document-maintenance",
  "main": "workers/document-maintenance/index.ts",
  "workers_dev": false,
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "UPLOAD_CLEANUP_URL": "https://www.qivaya.com/api/internal/document-upload-cleanup",
    "SCAN_RECOVERY_URL": "https://www.qivaya.com/api/internal/document-scan-recovery",
    "SCAN_POLL_URL": "https://www.qivaya.com/api/internal/document-scan-poll",
    "RETENTION_ENFORCEMENT_URL": "https://www.qivaya.com/api/internal/document-retention-enforcement",
    "SCAN_POLL_ENABLED": "false",
    "RETENTION_ENFORCEMENT_ENABLED": "false"
  },
  "triggers": {
    "crons": ["* * * * *", "*/10 * * * *", "7 * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
