{
  "name": "reyati-care",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "dev:vercel": "next dev",
    "build": "vinext build",
    "build:vercel": "next build",
    "start": "vinext start",
    "start:vercel": "next start",
    "test": "npm run build && node --test",
    "test:privileged": "node tests/privileged-workflows.mjs",
    "test:email-delivery": "node scripts/smoke-email-delivery.mjs",
    "test:document-maintenance": "node scripts/smoke-document-maintenance.mjs",
    "test:document-scanner": "node --test tests/document-scanner-opswat.test.mjs tests/document-scan-polling.test.mjs tests/document-upload.test.mjs tests/document-scanning.test.mjs",
    "test:document-retention": "node --test tests/document-retention-enforcement.test.mjs tests/document-retention-safety.test.mjs tests/document-deletion.test.mjs tests/legal-hold-operations.test.mjs tests/retention-automation.test.mjs tests/document-maintenance-dispatcher.test.mjs",
    "test:hosted-recovery": "node --test tests/hosted-recovery-rehearsal.test.mjs",
    "pilot:seed:generate": "node scripts/generate-production-pilot-seed.mjs",
    "verify:production": "node scripts/verify-production-readiness.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:communications-worker": "tsc --noEmit -p workers/communications-dispatcher/tsconfig.json",
    "typecheck:document-maintenance-worker": "tsc --noEmit -p workers/document-maintenance/tsconfig.json",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "verify": "npm run typecheck && npm run lint && npm test",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1113.0",
    "@clerk/nextjs": "^7.7.8",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "drizzle-orm": "0.45.2",
    "next": "16.2.11",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "stripe": "^20.4.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "sharp": "0.35.3"
  },
  "type": "module"
}
