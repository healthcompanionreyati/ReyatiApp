{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qivaya-communications-dispatcher",
  "main": "workers/communications-dispatcher/index.ts",
  "workers_dev": false,
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "DISPATCH_URL": "https://www.qivaya.com/api/internal/communications/dispatch"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
